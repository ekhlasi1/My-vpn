[Unit]
Description=BNDMAX VPN - Private DNS (DoT) server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/bndmax-dot-server
EnvironmentFile=/opt/bndmax-dot-server/.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=3
# Binding to port 853 needs this capability instead of running as root:
AmbientCapabilities=CAP_NET_BIND_SERVICE
User=nobody
Group=nogroup

[Install]
WantedBy=multi-user.target
