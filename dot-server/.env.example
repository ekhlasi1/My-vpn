# Copy to .env (or set these as real environment variables / systemd
# Environment= lines — this project doesn't load .env automatically, see
# README.md for how to wire it up with your process manager of choice).

# Hostname you'll point Android's Private DNS field at. Must match your TLS cert.
DOT_HOSTNAME=dns.example.com

# Android's Private DNS always dials 853 — leave this unless your client supports a custom port.
DOT_PORT=853

# TLS cert/key, e.g. from certbot: /etc/letsencrypt/live/<host>/fullchain.pem and privkey.pem
TLS_CERT_PATH=/etc/letsencrypt/live/dns.example.com/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/dns.example.com/privkey.pem

# Your deployed BNDMAX VPN Worker's base URL (the /api/dns-rules list is served from here).
WORKER_BASE_URL=https://your-worker.example.workers.dev

# Optional tuning (defaults shown):
# RULES_REFRESH_SECONDS=60
# UPSTREAM_DOH_URL=https://1.1.1.1/dns-query
# OVERRIDE_TTL=60
# FALLBACK_CLEAN_IP=
